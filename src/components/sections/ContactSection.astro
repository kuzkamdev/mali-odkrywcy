---
import type { ContactData } from "../../types/content";
import ButtonLink from "../shared/ButtonLink.astro";
import SectionHeading from "../shared/SectionHeading.astro";

interface Props {
  data: ContactData;
}

const { data } = Astro.props;
---

<section class="section contact" id="kontakt">
  <div class="container contact__grid">
    <div class="contact__content">
      <SectionHeading
        eyebrow={data.eyebrow}
        title={data.title}
        description={data.description}
      />
      <ButtonLink action={data.action} />
    </div>

    <div class="contact-card">
      <div class="contact-card__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24">
          <path d="M12 21s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12Z" />
          <circle cx="12" cy="9" r="2.5" />
        </svg>
      </div>
      <div>
        <p class="contact-card__label">Znajdziesz nas tutaj</p>
        <address>
          <strong>{data.name}</strong><br />
          {data.address.street}<br />
          {data.address.postalCode} {data.address.city}<br />
          {data.address.district}
        </address>
        <div class="contact-card__details">
          {data.phone && <a href={`tel:${data.phone.replaceAll(" ", "")}`}>{data.phone}</a>}
          {data.email && <a href={`mailto:${data.email}`}>{data.email}</a>}
        </div>
        <a class="text-link" href={data.mapUrl} target="_blank" rel="noreferrer">
          Pokaż na mapie
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </div>
</section>
