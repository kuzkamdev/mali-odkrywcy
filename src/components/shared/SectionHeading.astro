---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: "left" | "center";
  theme?: "default" | "light";
}

const {
  eyebrow,
  title,
  description,
  align = "left",
  theme = "default",
} = Astro.props;
---

<header class:list={["section-heading", `section-heading--${align}`, `section-heading--${theme}`]}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2>{title}</h2>
  {description && <p class="section-heading__description">{description}</p>}
</header>

