---
import type { ContactData } from "../../types/content";

interface Props {
  contact: ContactData;
}

const { contact } = Astro.props;
const phoneHref = contact.phone?.replaceAll(" ", "");
---

{phoneHref && (
  <nav class="mobile-contact-bar" aria-label="Szybki kontakt">
    <a href={`tel:${phoneHref}`}>
      <svg aria-hidden="true" viewBox="0 0 24 24">
        <path d="M7 3H4.5C3.7 3 3 3.7 3 4.5 3 13.6 10.4 21 19.5 21c.8 0 1.5-.7 1.5-1.5V17l-4-1.5-1.3 2.1a15.8 15.8 0 0 1-9.3-9.3L8.5 7 7 3Z" />
      </svg>
      Zadzwoń
    </a>
    <a href={contact.facebookUrl} target="_blank" rel="noreferrer">
      <svg aria-hidden="true" viewBox="0 0 24 24">
        <path d="M14 8h3V4h-3c-3.3 0-5 2-5 5v3H6v4h3v5h4v-5h3.2l.8-4h-4V9c0-.7.3-1 1-1Z" />
      </svg>
      Facebook
    </a>
  </nav>
)}
