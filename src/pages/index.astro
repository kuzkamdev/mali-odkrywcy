---
import AboutSection from "../components/sections/AboutSection.astro";
import ActivitiesSection from "../components/sections/ActivitiesSection.astro";
import ContactSection from "../components/sections/ContactSection.astro";
import DailyLifeSection from "../components/sections/DailyLifeSection.astro";
import DiscoverySection from "../components/sections/DiscoverySection.astro";
import HeroSection from "../components/sections/HeroSection.astro";
import RecruitmentSection from "../components/sections/RecruitmentSection.astro";
import ReviewsSection from "../components/sections/ReviewsSection.astro";
import { homePageData } from "../data/home";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title={homePageData.metaTitle}
  description={homePageData.metaDescription}
  siteName={homePageData.siteName}
  navigation={homePageData.navigation}
  contact={homePageData.contact}
>
  <HeroSection data={homePageData.hero} />
  {homePageData.about.enabled && <AboutSection data={homePageData.about} />}
  {homePageData.discovery.enabled && (
    <DiscoverySection data={homePageData.discovery} />
  )}
  <ActivitiesSection data={homePageData.activities} />
  {homePageData.dailyLife.enabled && (
    <DailyLifeSection data={homePageData.dailyLife} />
  )}
  {homePageData.reviews.enabled && (
    <ReviewsSection data={homePageData.reviews} />
  )}
  {homePageData.recruitment.enabled && (
    <RecruitmentSection data={homePageData.recruitment} />
  )}
  {homePageData.contact.enabled && (
    <ContactSection data={homePageData.contact} />
  )}
</BaseLayout>
